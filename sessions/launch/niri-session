#!/bin/sh
# Managed by LQ13ofc/asahi-system. Niri owns the graphical-session systemd
# lifecycle; this wrapper only selects this repository's B1 config and starts
# the distro-provided niri-session entry point.
set -eu

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=niri
export XDG_SESSION_DESKTOP=niri
export NIRI_CONFIG=/usr/local/share/asahi-system/niri/config.kdl

exec /usr/bin/niri-session "$@"
