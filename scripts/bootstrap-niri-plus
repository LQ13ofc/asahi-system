#!/usr/bin/env python3
"""Install the Niri+ CLI/runtime from a verified, closed Git snapshot.

Public use is a read-only dry run. The privileged apply form is internal to
``sudo niri+ install`` and requires its root-owned snapshot manifest.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import shutil
import sys
import tempfile
from datetime import datetime, timezone

ROOT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

LIB = pathlib.Path("/usr/local/lib/niri-plus")
DATA = pathlib.Path("/usr/local/share/niri-plus")
BIN = pathlib.Path("/usr/local/bin/niri+")
STATE = pathlib.Path("/var/lib/niri-plus/bootstrap.json")
BACKUPS = pathlib.Path("/var/lib/niri-plus/bootstrap-backups")
EXPECTED_MANAGED = [str(LIB), str(DATA), str(BIN)]


def launcher() -> str:
    return '''#!/usr/bin/python3 -I
import sys
import os
os.environ.setdefault("NIRI_PLUS_DATA_DIR", "/usr/local/share/niri-plus")
sys.path.insert(0, "/usr/local/lib/niri-plus")
from niri_plus.cli import main
raise SystemExit(main())
'''


def check_no_symlink_parents(path: pathlib.Path) -> None:
    current = pathlib.Path("/")
    for part in path.absolute().parts[1:]:
        current /= part
        if current.is_symlink():
            raise RuntimeError(f"managed path has a symlinked parent: {current}")


def _signature(path: pathlib.Path):
    if path.is_symlink():
        return ("link", os.readlink(path))
    if path.is_file():
        return ("file", hashlib.sha256(path.read_bytes()).hexdigest(), path.stat().st_mode & 0o777)
    if path.is_dir():
        result = []
        for child in sorted(path.iterdir(), key=lambda item: item.name):
            result.append((child.name, _signature(child)))
        return ("dir", tuple(result))
    return ("absent",)


def _copy(source: pathlib.Path, destination: pathlib.Path) -> None:
    if source.is_dir() and not source.is_symlink():
        shutil.copytree(source, destination, symlinks=True, copy_function=shutil.copy2)
    elif source.is_symlink():
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.symlink_to(os.readlink(source), target_is_directory=source.is_dir())
    else:
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination, follow_symlinks=False)


def _remove(path: pathlib.Path) -> None:
    if path.is_symlink() or (path.exists() and not path.is_dir()):
        path.unlink()
    elif path.exists():
        shutil.rmtree(path)


def _validate_ownership() -> tuple[dict, bool]:
    for path in (STATE.parent, LIB.parent, DATA.parent, BIN.parent, BACKUPS):
        check_no_symlink_parents(path)
    if STATE.is_symlink():
        raise RuntimeError("bootstrap ownership state is a symlink; refusing to follow it")
    state = {}
    if STATE.exists():
        metadata = STATE.stat()
        if not STATE.is_file() or metadata.st_uid != 0 or metadata.st_mode & 0o022:
            raise RuntimeError("bootstrap ownership state has unsafe type, owner, or permissions")
        state = json.loads(STATE.read_text(encoding="utf-8"))
        if state.get("schema_version") not in (1, 2) or state.get("managed") != EXPECTED_MANAGED:
            raise RuntimeError("bootstrap ownership state is unknown; refusing to overwrite destinations")
    elif any(path.exists() or path.is_symlink() for path in (LIB, DATA, BIN)):
        raise RuntimeError("Niri+ bootstrap destinations exist without ownership state")
    if any(path.is_symlink() for path in (LIB, DATA, BIN)):
        raise RuntimeError("a managed bootstrap destination is a symlink; refusing to replace it")
    return state, bool(state)


def install_snapshot(snapshot_root: pathlib.Path, manifest_path: pathlib.Path) -> None:
    if os.geteuid() != 0:
        raise RuntimeError("snapshot apply requires root")
    from niri_plus import source_update

    manifest = source_update.validate_snapshot(snapshot_root, manifest_path)
    system = manifest["system"]
    quickshell = manifest["quickshell"]
    if system.get("branch") != "main" or system.get("repository") != source_update.EXPECTED_REPOSITORY:
        raise RuntimeError("snapshot is not from the approved asahi-system main source")
    if quickshell.get("repository") != source_update.EXPECTED_QUICKSHELL_REPOSITORY:
        raise RuntimeError("snapshot Quickshell origin is not approved")
    version = (snapshot_root / "VERSION").read_text(encoding="utf-8").strip()
    if not version:
        raise RuntimeError("snapshot Niri+ VERSION is empty")
    lock = json.loads((snapshot_root / "integration/quickshell.lock.json").read_text(encoding="utf-8"))
    if lock.get("commit") != quickshell.get("commit") or lock.get("repository") != quickshell.get("repository"):
        raise RuntimeError("snapshot Quickshell lock and fetched visual snapshot disagree")

    state, has_state = _validate_ownership()
    changed = any(not path.exists() for path in (LIB, DATA, BIN))
    stage = pathlib.Path(tempfile.mkdtemp(prefix=".niri-plus-stage-", dir="/usr/local"))
    state_tmp = None
    try:
        lib_stage = stage / "lib/niri-plus"
        data_stage = stage / "share/niri-plus"
        lib_stage.mkdir(parents=True)
        _copy(snapshot_root / "niri_plus", lib_stage / "niri_plus")
        pycache = lib_stage / "niri_plus/__pycache__"
        if pycache.exists():
            shutil.rmtree(pycache)
        data_stage.mkdir(parents=True)
        _copy(snapshot_root / "VERSION", data_stage / "VERSION")
        _copy(snapshot_root / "niri", data_stage / "niri")
        _copy(snapshot_root / "sessions", data_stage / "sessions")
        _copy(snapshot_root / "integration", data_stage / "integration")
        (data_stage / "scripts").mkdir()
        collector = snapshot_root / "scripts/collect-performance-baseline"
        _copy(collector, data_stage / "scripts/collect-performance-baseline")
        (data_stage / "scripts/collect-performance-baseline").chmod(0o755)
        _copy(snapshot_root / "external/quickshell", data_stage / "quickshell")
        (data_stage / "quickshell.snapshot.json").write_text(json.dumps({
            "schema_version": 1,
            "repository": quickshell["repository"],
            "commit": quickshell["commit"],
            "files": quickshell["files"],
        }, sort_keys=True, indent=2) + "\n", encoding="utf-8")
        bin_stage = stage / "niri+"
        bin_stage.write_text(launcher(), encoding="utf-8")
        bin_stage.chmod(0o755)

        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ") + f"-{os.getpid()}"
        backup = None
        if has_state:
            differences = any(_signature(current) != _signature(staged) for current, staged in (
                (LIB, lib_stage), (DATA, data_stage), (BIN, bin_stage),
            ))
            changed = differences
            if differences:
                backup_root = BACKUPS / stamp
                backup_root.mkdir(parents=True, exist_ok=False)
                for current, label in ((LIB, "lib"), (DATA, "share"), (BIN, "bin")):
                    if current.exists() or current.is_symlink():
                        _copy(current, backup_root / label)
                backup = str(backup_root)
            else:
                backup = state.get("backup")
        else:
            changed = True

        source_root = manifest.get("source_root")
        if not isinstance(source_root, str) or not source_root.startswith("/"):
            raise RuntimeError("snapshot does not identify the configured user source checkout")
        new_state = {
            "schema_version": 2,
            "version": version,
            "backup": backup,
            "managed": EXPECTED_MANAGED,
            "source_root": source_root,
            "source_repository": system["repository"],
            "source_branch": system["branch"],
            "source_commit": system["commit"],
            "snapshot_sha256": manifest["snapshot_sha256"],
            "quickshell_repository": quickshell["repository"],
            "quickshell_expected_commit": quickshell["commit"],
            "quickshell_source": str(DATA / "quickshell"),
        }
        STATE.parent.mkdir(parents=True, exist_ok=True)
        fd, state_tmp = tempfile.mkstemp(prefix=".bootstrap-state-", dir=STATE.parent)
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            json.dump(new_state, output, sort_keys=True, indent=2)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
            os.fchmod(output.fileno(), 0o644)

        if changed:
            for current, staged in ((LIB, lib_stage), (DATA, data_stage), (BIN, bin_stage)):
                current.parent.mkdir(parents=True, exist_ok=True)
                _remove(current)
                os.replace(staged, current)
        os.replace(state_tmp, STATE)
        state_tmp = None
        print(f"Installed Niri+ CLI {version}; asahi-system {system['commit'][:12]}; Quickshell {quickshell['commit'][:12]}.")
    finally:
        shutil.rmtree(stage, ignore_errors=True)
        if state_tmp and os.path.exists(state_tmp):
            os.unlink(state_tmp)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--snapshot-root", type=pathlib.Path, help=argparse.SUPPRESS)
    parser.add_argument("--snapshot-manifest", type=pathlib.Path, help=argparse.SUPPRESS)
    args = parser.parse_args()
    if not args.apply:
        print("Niri+ bootstrap dry-run (no host changes)")
        print(f"Destinations: {LIB}, {DATA}, {BIN}")
        print("Apply only through: sudo niri+ install")
        return 0
    if not args.snapshot_root or not args.snapshot_manifest:
        print("bootstrap --apply requires a verified snapshot; use sudo niri+ install", file=sys.stderr)
        return 2
    try:
        install_snapshot(args.snapshot_root, args.snapshot_manifest)
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as exc:
        print(f"bootstrap failed: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
