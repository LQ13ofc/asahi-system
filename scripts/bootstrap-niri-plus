#!/usr/bin/env python3
"""Install the niri+ CLI and its read-only benchmark/runtime assets.

The default is a dry-run. Apply with sudo only after reviewing this script.
It does not install Niri or change the graphical session.
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import platform
import pwd
import re
import shutil
import sys
import tempfile
import subprocess
from datetime import datetime, timezone

ROOT = pathlib.Path(__file__).resolve().parents[1]
QUICKSHELL_SOURCE = ROOT / "external/quickshell"
LIB = pathlib.Path("/usr/local/lib/niri-plus")
DATA = pathlib.Path("/usr/local/share/niri-plus")
BIN = pathlib.Path("/usr/local/bin/niri+")
STATE = pathlib.Path("/var/lib/niri-plus/bootstrap.json")


def normalize_repository(value: str) -> str:
    value = value.strip().lower()
    value = re.sub(r"^git@github\.com:", "https://github.com/", value)
    value = re.sub(r"^ssh://git@github\.com/", "https://github.com/", value)
    return value.rstrip("/").removesuffix(".git")


def check_no_symlink_parents(path: pathlib.Path) -> None:
    current = pathlib.Path("/")
    for part in path.absolute().parts[1:]:
        current = current / part
        if current.is_symlink():
            raise RuntimeError(f"managed path has a symlinked parent: {current}")


def launcher() -> str:
    return """#!/usr/bin/python3
import sys
import os
os.environ.setdefault("NIRI_PLUS_DATA_DIR", "/usr/local/share/niri-plus")
sys.path.insert(0, "/usr/local/lib/niri-plus")
from niri_plus.cli import main
raise SystemExit(main())
"""


def git_as_checkout_owner(path: pathlib.Path, *args: str) -> subprocess.CompletedProcess[str]:
    """Run Git probes without elevating repository config/hooks to root."""
    try:
        metadata = path.stat()
        account = pwd.getpwuid(metadata.st_uid)
        groups = os.getgrouplist(account.pw_name, account.pw_gid)
    except (OSError, KeyError) as exc:
        raise RuntimeError(f"cannot determine checkout owner: {path}") from exc
    env = os.environ.copy()
    for key in tuple(env):
        if key.startswith("GIT_"):
            env.pop(key, None)
    env.update({"HOME": account.pw_dir, "USER": account.pw_name,
                "LOGNAME": account.pw_name, "GIT_CONFIG_NOSYSTEM": "1",
                "GIT_CONFIG_GLOBAL": os.devnull, "GIT_TERMINAL_PROMPT": "0"})
    command = ["git", "-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false",
               "-C", str(path), *args]
    options = {"user": account.pw_uid, "group": account.pw_gid, "extra_groups": groups} if os.geteuid() != account.pw_uid else {}
    return subprocess.run(command, check=True, text=True, capture_output=True, env=env, **options)


def copy_tree(source: pathlib.Path, destination: pathlib.Path) -> None:
    shutil.copytree(source, destination, symlinks=True)


def validate_quickshell_source() -> tuple[str, dict]:
    lock = json.loads((ROOT / "integration/quickshell.lock.json").read_text(encoding="utf-8"))
    if lock.get("schema_version") != 1 or lock.get("checkout") != "external/quickshell":
        raise RuntimeError("Quickshell lock has an unknown schema or checkout path")
    try:
        commit = git_as_checkout_owner(QUICKSHELL_SOURCE, "rev-parse", "--verify", "HEAD").stdout.strip()
        remote = git_as_checkout_owner(QUICKSHELL_SOURCE, "remote", "get-url", "origin").stdout.strip()
        dirty = git_as_checkout_owner(QUICKSHELL_SOURCE, "status", "--porcelain", "--untracked-files=all").stdout
    except (OSError, subprocess.CalledProcessError) as exc:
        raise RuntimeError("initialize the private Quickshell submodule with authenticated Git access before bootstrap") from exc
    if commit != lock.get("commit"):
        raise RuntimeError(f"Quickshell submodule is not at its locked commit ({commit}; expected {lock.get('commit')})")
    if normalize_repository(remote) != normalize_repository(lock.get("repository", "")):
        raise RuntimeError("Quickshell submodule origin does not match the repository in the lock file")
    if dirty:
        raise RuntimeError("Quickshell submodule has local modifications; bootstrap requires the exact clean pinned commit")
    return commit, lock


def validate_system_source() -> tuple[str, str]:
    if not (ROOT / ".git").exists():
        raise RuntimeError("bootstrap requires a Git checkout of LQ13ofc/asahi-system main")
    try:
        origin = git_as_checkout_owner(ROOT, "remote", "get-url", "origin").stdout.strip()
        branch = git_as_checkout_owner(ROOT, "branch", "--show-current").stdout.strip()
        dirty = git_as_checkout_owner(ROOT, "status", "--porcelain", "--untracked-files=all").stdout
        head = git_as_checkout_owner(ROOT, "rev-parse", "HEAD").stdout.strip()
        upstream = git_as_checkout_owner(ROOT, "rev-parse", "refs/remotes/origin/main").stdout.strip()
    except (OSError, subprocess.CalledProcessError) as exc:
        raise RuntimeError("could not verify the system source checkout and cached origin/main") from exc
    if normalize_repository(origin) != "https://github.com/lq13ofc/asahi-system":
        raise RuntimeError(f"unexpected asahi-system origin: {origin}")
    if branch != "main":
        raise RuntimeError(f"bootstrap requires branch main, found {branch or 'detached HEAD'}")
    if dirty:
        raise RuntimeError("asahi-system checkout has local changes; bootstrap requires a clean tree")
    if not head or head != upstream:
        raise RuntimeError("asahi-system HEAD must equal cached origin/main before bootstrap")
    return head, branch


def install() -> None:
    if os.geteuid() != 0:
        raise RuntimeError("bootstrap --apply requires root; use sudo ./scripts/bootstrap-niri-plus --apply")
    system_commit, system_branch = validate_system_source()
    quickshell_commit, quickshell_lock = validate_quickshell_source()
    for path in (STATE.parent, LIB.parent, DATA.parent, BIN.parent,
                 pathlib.Path("/var/lib/niri-plus/bootstrap-backups")):
        check_no_symlink_parents(path)
    if STATE.is_symlink():
        raise RuntimeError("bootstrap ownership state is a symlink; refusing to follow it")
    if STATE.exists():
        metadata = STATE.stat()
        if not STATE.is_file() or metadata.st_uid != 0 or metadata.st_mode & 0o022:
            raise RuntimeError("bootstrap ownership state has unsafe type, owner, or permissions")
    existing = any(path.exists() for path in (LIB, DATA, BIN))
    state = {}
    if STATE.exists():
        state = json.loads(STATE.read_text(encoding="utf-8"))
        expected_paths = [str(LIB), str(DATA), str(BIN)]
        if state.get("schema_version") != 1 or state.get("managed") != expected_paths:
            raise RuntimeError("bootstrap ownership state is unknown; refusing to overwrite destinations")
    elif existing:
        raise RuntimeError("Niri+ bootstrap destinations already exist without ownership state; refusing to overwrite them")
    if any(path.is_symlink() for path in (LIB, DATA, BIN)):
        raise RuntimeError("a managed bootstrap destination is a symlink; refusing to replace it")

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ") + f"-{os.getpid()}"
    backup_root = pathlib.Path("/var/lib/niri-plus/bootstrap-backups") / stamp
    STATE.parent.mkdir(parents=True, exist_ok=True)
    state_content = json.dumps({
        "schema_version": 1,
        "version": (ROOT / "VERSION").read_text(encoding="utf-8").strip(),
        "backup": str(backup_root) if existing else None,
        "managed": [str(LIB), str(DATA), str(BIN)],
        "source_root": str(ROOT.resolve()),
        "source_repository": "https://github.com/LQ13ofc/asahi-system.git",
        "source_branch": system_branch,
        "source_commit": system_commit,
        "quickshell_repository": quickshell_lock["repository"],
        "quickshell_expected_commit": quickshell_commit,
        "quickshell_source": str(QUICKSHELL_SOURCE.resolve()),
    }, indent=2) + "\n"
    fd, temporary_state = tempfile.mkstemp(prefix=".bootstrap-state-", dir=STATE.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            output.write(state_content)
            output.flush()
            os.fsync(output.fileno())
            os.fchmod(output.fileno(), 0o644)
    except Exception:
        if os.path.exists(temporary_state):
            os.unlink(temporary_state)
        raise

    replaced = []
    if existing:
        backup_root.mkdir(parents=True, exist_ok=False)
        managed_paths = ((LIB, "lib"), (DATA, "share"), (BIN, "bin"))
        for path, label in managed_paths:
            if path.exists() or path.is_symlink():
                saved = backup_root / label
                if path.is_dir() and not path.is_symlink():
                    copy_tree(path, saved)
                else:
                    saved.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(path, saved, follow_symlinks=False)
                replaced.append(str(saved))

    staging = pathlib.Path(tempfile.mkdtemp(prefix=".niri-plus-bootstrap-", dir="/usr/local"))
    try:
        lib_stage = staging / "lib/niri-plus"
        data_stage = staging / "share/niri-plus"
        lib_stage.mkdir(parents=True)
        copy_tree(ROOT / "niri_plus", lib_stage / "niri_plus")
        (lib_stage / "niri_plus/__pycache__").exists() and shutil.rmtree(lib_stage / "niri_plus/__pycache__")
        data_stage.mkdir(parents=True)
        shutil.copy2(ROOT / "VERSION", data_stage / "VERSION")
        copy_tree(ROOT / "niri", data_stage / "niri")
        copy_tree(ROOT / "sessions", data_stage / "sessions")
        copy_tree(ROOT / "integration", data_stage / "integration")
        (data_stage / "scripts").mkdir()
        shutil.copy2(ROOT / "scripts/collect-performance-baseline", data_stage / "scripts/collect-performance-baseline")
        data_stage.joinpath("scripts/collect-performance-baseline").chmod(0o755)
        for target in (LIB, DATA):
            if target.exists():
                shutil.rmtree(target)
        LIB.parent.mkdir(parents=True, exist_ok=True)
        DATA.parent.mkdir(parents=True, exist_ok=True)
        os.replace(lib_stage, LIB)
        os.replace(data_stage, DATA)
        quickshell_link = DATA / "quickshell"
        if quickshell_link.exists() or quickshell_link.is_symlink():
            if quickshell_link.is_dir() and not quickshell_link.is_symlink():
                shutil.rmtree(quickshell_link)
            else:
                quickshell_link.unlink()
        quickshell_link.symlink_to(QUICKSHELL_SOURCE.resolve(), target_is_directory=True)
        bin_stage = staging / "niri+"
        bin_stage.write_text(launcher(), encoding="utf-8")
        bin_stage.chmod(0o755)
        if BIN.exists() or BIN.is_symlink():
            BIN.unlink()
        BIN.parent.mkdir(parents=True, exist_ok=True)
        os.replace(bin_stage, BIN)
        os.replace(temporary_state, STATE)
    except Exception:
        for path, label in ((LIB, "lib"), (DATA, "share"), (BIN, "bin")):
            saved = backup_root / label
            if path.is_dir() and not path.is_symlink():
                shutil.rmtree(path)
            elif path.exists() or path.is_symlink():
                path.unlink()
            if saved.is_dir() and not saved.is_symlink():
                copy_tree(saved, path)
            elif saved.exists() or saved.is_symlink():
                path.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(saved, path, follow_symlinks=False)
        raise
    finally:
        shutil.rmtree(staging, ignore_errors=True)
        if os.path.exists(temporary_state):
            os.unlink(temporary_state)
    print(f"Installed Niri+ CLI { (ROOT / 'VERSION').read_text(encoding='utf-8').strip() } at {BIN}")
    print("No Niri packages or graphical session files were installed.")
    if replaced:
        print(f"Previous Niri+ CLI files were copied to {backup_root}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help="install the CLI; requires root")
    args = parser.parse_args()
    if not args.apply:
        print("Niri+ CLI bootstrap dry-run (no host changes)")
        print(f"Version: {(ROOT / 'VERSION').read_text(encoding='utf-8').strip()}")
        print(f"Destinations: {LIB}, {DATA}, {BIN}")
        try:
            system_commit, _ = validate_system_source()
            print(f"asahi-system main: {system_commit}")
            commit, _ = validate_quickshell_source()
            print(f"Quickshell submodule pin: {commit}")
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as exc:
            print(f"Quickshell submodule: not ready ({exc})")
        print("To apply: sudo ./scripts/bootstrap-niri-plus --apply")
        return 0
    try:
        install()
    except (OSError, RuntimeError, ValueError) as exc:
        print(f"bootstrap failed: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
