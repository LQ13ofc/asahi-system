#!/usr/bin/env python3
"""Read-only, best-effort Fedora/Asahi performance snapshot collector."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import pathlib
import platform
import resource
import shutil
import subprocess
import sys
import statistics
import time
import tempfile
from typing import Any


REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
# Source checkout: scripts/ and niri_plus/ are siblings. The installed
# bootstrap deliberately separates read-only data under /usr/local/share
# from trusted Python modules under /usr/local/lib. Resolve that split
# without PYTHONPATH or a user-writable fallback.
if REPO_ROOT.name == "niri-plus" and REPO_ROOT.parent.name == "share":
    MODULE_ROOT = REPO_ROOT.parent.parent / "lib/niri-plus"
else:
    MODULE_ROOT = REPO_ROOT
sys.path.insert(0, str(MODULE_ROOT))

from niri_plus import benchmark_metrics, memory_report


AVAILABLE = "AVAILABLE"
UNAVAILABLE = "UNAVAILABLE"
PERMISSION_REQUIRED = "PERMISSION_REQUIRED"
NOT_APPLICABLE = "NOT_APPLICABLE"
NOT_ACCOUNTED = "NOT_ACCOUNTED"


def metric(status: str, value: Any = None, note: str | None = None) -> dict[str, Any]:
    out: dict[str, Any] = {"status": status}
    if value is not None:
        out["value"] = value
    if note:
        out["note"] = note
    return out


def read_text(path: pathlib.Path) -> tuple[str | None, str | None]:
    try:
        return path.read_text(encoding="utf-8", errors="replace"), None
    except PermissionError as exc:
        return None, str(exc)
    except (FileNotFoundError, NotADirectoryError) as exc:
        return None, str(exc)
    except OSError as exc:
        return None, str(exc)


def status_for_error(error: str | None) -> str:
    if error and ("Permission denied" in error or "Operation not permitted" in error):
        return PERMISSION_REQUIRED
    return UNAVAILABLE


def parse_key_values(text: str) -> dict[str, int]:
    result: dict[str, int] = {}
    for line in text.splitlines():
        fields = line.split()
        if len(fields) >= 2:
            try:
                result[fields[0].rstrip(":")] = int(fields[1])
            except ValueError:
                continue
    return result


def command(args: list[str], timeout: float = 4) -> dict[str, Any]:
    if not shutil.which(args[0]):
        return metric(UNAVAILABLE, note=f"tool not installed: {args[0]}")
    try:
        result = subprocess.run(args, text=True, capture_output=True, check=False, timeout=timeout)
    except PermissionError as exc:
        return metric(PERMISSION_REQUIRED, note=str(exc))
    except (OSError, subprocess.TimeoutExpired) as exc:
        return metric(UNAVAILABLE, note=str(exc))
    if result.returncode:
        return metric(UNAVAILABLE, {"returncode": result.returncode, "stdout": result.stdout.strip(), "stderr": result.stderr.strip()})
    return metric(AVAILABLE, result.stdout.strip())


class Collector:
    """Collect from the host; root_prefix exists for isolated tests only."""

    def __init__(self, root_prefix: pathlib.Path | None = None, observation_window: float = 10.0,
                 profile_sample_period: float = 0.5):
        self.root_prefix = root_prefix
        self.observation_window = max(0.0, observation_window)
        self.profile_sample_period = max(0.2, profile_sample_period)

    def path(self, absolute: str) -> pathlib.Path:
        if self.root_prefix:
            return self.root_prefix / absolute.lstrip("/")
        return pathlib.Path(absolute)

    def text_metric(self, absolute: str) -> dict[str, Any]:
        value, error = read_text(self.path(absolute))
        if error:
            return metric(status_for_error(error), note=f"{absolute}: {error}")
        return metric(AVAILABLE, value.strip())

    def _meminfo(self) -> tuple[dict[str, int] | None, dict[str, Any]]:
        text, error = read_text(self.path("/proc/meminfo"))
        if error:
            return None, metric(status_for_error(error), note=f"/proc/meminfo: {error}")
        values = parse_key_values(text)
        # Linux meminfo memory quantities are kB; normalize to bytes.
        return {key: value * 1024 for key, value in values.items()}, metric(AVAILABLE, values)

    def system(self) -> dict[str, Any]:
        uname = command(["uname", "-a"])
        release: dict[str, Any]
        os_release, error = read_text(self.path("/etc/os-release"))
        if error:
            release = metric(status_for_error(error), note=f"/etc/os-release: {error}")
        else:
            release = metric(AVAILABLE, {k: v.strip().strip('"') for line in os_release.splitlines() if "=" in line for k, v in [line.split("=", 1)]})
        uptime_text, uptime_error = read_text(self.path("/proc/uptime"))
        try:
            uptime = metric(UNAVAILABLE, note=f"/proc/uptime: {uptime_error}") if uptime_error else metric(AVAILABLE, float(uptime_text.split()[0]))
        except (ValueError, IndexError):
            uptime = metric(UNAVAILABLE, note="malformed /proc/uptime")
        session_type = os.environ.get("XDG_SESSION_TYPE")
        desktop = os.environ.get("XDG_CURRENT_DESKTOP") or os.environ.get("XDG_SESSION_DESKTOP")
        known_compositors = {"niri", "kwin_wayland", "sway", "Hyprland", "gnome-shell", "weston"}
        compositor_names = []
        try:
            for pid_path in self.path("/proc").iterdir():
                if pid_path.name.isdigit():
                    name, _ = read_text(pid_path / "comm")
                    if name and name.strip() in known_compositors:
                        compositor_names.append(name.strip())
        except OSError:
            pass
        repo = pathlib.Path(__file__).resolve().parent.parent
        asahi_commit = command(["git", "-C", str(repo), "rev-parse", "HEAD"])
        version_path = self.path("/usr/local/share/niri-plus/VERSION")
        version_text, _ = read_text(version_path)
        if version_text is None:
            source_version, source_error = read_text(repo / "VERSION")
            niri_plus_version = metric(AVAILABLE, source_version.strip()) if source_version else metric(status_for_error(source_error), note=source_error)
        else:
            niri_plus_version = metric(AVAILABLE, version_text.strip())
        lock_path = repo / "integration/quickshell.lock.json"
        try:
            lock = json.loads(lock_path.read_text(encoding="utf-8"))
            expected_qs_commit = lock.get("commit")
            if not isinstance(expected_qs_commit, str) or len(expected_qs_commit) != 40:
                expected_qs_commit = None
        except (OSError, ValueError, json.JSONDecodeError):
            expected_qs_commit = None
        runtime_qs_snapshot = self.path("/usr/local/share/niri-plus/quickshell.snapshot.json")
        try:
            installed_qs_commit = json.loads(runtime_qs_snapshot.read_text(encoding="utf-8")).get("commit")
            if not isinstance(installed_qs_commit, str) or len(installed_qs_commit) != 40:
                installed_qs_commit = None
        except (OSError, ValueError, json.JSONDecodeError):
            installed_qs_commit = None
        niri_version = command(["niri", "--version"])
        quickshell_version = command(["qs", "--version"])
        quickshell_dir = os.environ.get("QUICKSHELL_REPO_DIR")
        if not quickshell_dir:
            sibling = repo.parent / "quickshell-"
            if sibling.is_dir():
                quickshell_dir = str(sibling)
        quickshell_commit = command(["git", "-C", quickshell_dir, "rev-parse", "HEAD"]) if quickshell_dir else metric(UNAVAILABLE, note="set QUICKSHELL_REPO_DIR when the separate quickshell- checkout is available")
        device_model, model_error = read_text(self.path("/proc/device-tree/model"))
        asahi_hint = "asahi" in platform.release().lower() or "apple" in (device_model or "").lower()
        if device_model:
            asahi_hardware = metric(AVAILABLE, device_model.strip().rstrip("\x00"))
        elif platform.machine() not in ("aarch64", "arm64") or not asahi_hint:
            asahi_hardware = metric(NOT_APPLICABLE, note="no Apple/Asahi hardware identified in this environment")
        else:
            asahi_hardware = metric(status_for_error(model_error), note="device-tree model unavailable")
        return {
            "uname": uname,
            "fedora_asahi_release": release,
            "architecture": metric(AVAILABLE, platform.machine()),
            "page_size_bytes": metric(AVAILABLE, int(os.sysconf("SC_PAGE_SIZE"))),
            "uptime_seconds": uptime,
            "session_type": metric(AVAILABLE, session_type) if session_type else metric(UNAVAILABLE, note="XDG_SESSION_TYPE is unset"),
            "desktop": metric(AVAILABLE, desktop) if desktop else metric(UNAVAILABLE, note="desktop session environment is unset"),
            "compositor": metric(AVAILABLE, sorted(set(compositor_names))) if compositor_names else metric(UNAVAILABLE, note="known compositor process not found in /proc"),
            "asahi_hardware": asahi_hardware,
            "asahi_system_commit": asahi_commit,
            "niri_plus_version": niri_plus_version,
            "niri_compositor_version": niri_version,
            "quickshell_version": quickshell_version,
            "quickshell_expected_commit": metric(AVAILABLE, expected_qs_commit) if expected_qs_commit else metric(UNAVAILABLE, note="Quickshell lock unavailable or malformed"),
            "quickshell_installed_commit": metric(AVAILABLE, installed_qs_commit) if installed_qs_commit else metric(UNAVAILABLE, note="installed Quickshell snapshot manifest unavailable"),
            "quickshell_commit": quickshell_commit,
        }

    def memory(self) -> dict[str, Any]:
        mem, source = self._meminfo()
        keys = {
            "mem_total_bytes": "MemTotal",
            "mem_available_bytes": "MemAvailable",
            "mem_free_bytes": "MemFree",
            "buffers_bytes": "Buffers",
            "cached_bytes": "Cached",
            "shmem_bytes": "Shmem",
            "sreclaimable_bytes": "SReclaimable",
            "sunreclaim_bytes": "SUnreclaim",
            "slab_bytes": "Slab",
            "anon_pages_bytes": "AnonPages",
            "mapped_bytes": "Mapped",
            "kernel_stack_bytes": "KernelStack",
            "page_tables_bytes": "PageTables",
            "unevictable_bytes": "Unevictable",
            "active_bytes": "Active",
            "inactive_bytes": "Inactive",
            "swap_total_bytes": "SwapTotal",
            "swap_free_bytes": "SwapFree",
        }
        if mem is None:
            values = {name: source for name in keys}
            used = source
            swap_used = source
            kernel_slab = source
        else:
            total, available = mem.get("MemTotal"), mem.get("MemAvailable")
            swap_total, swap_free = mem.get("SwapTotal"), mem.get("SwapFree")
            values = {
                name: metric(AVAILABLE, mem[key]) if key in mem and mem[key] >= 0 else metric(UNAVAILABLE, note=f"{key} missing or negative in /proc/meminfo")
                for name, key in keys.items()
            }
            used = (
                metric(AVAILABLE, total - available)
                if total is not None and available is not None and 0 <= available <= total
                else metric(UNAVAILABLE, note="requires 0 <= MemAvailable <= MemTotal")
            )
            swap_used = (
                metric(AVAILABLE, swap_total - swap_free)
                if swap_total is not None and swap_free is not None and 0 <= swap_free <= swap_total
                else metric(UNAVAILABLE, note="requires 0 <= SwapFree <= SwapTotal")
            )
            slab_parts = (mem.get("SReclaimable"), mem.get("SUnreclaim"))
            if "Slab" in mem and mem["Slab"] >= 0:
                kernel_slab = metric(AVAILABLE, mem["Slab"])
            elif all(value is not None and value >= 0 for value in slab_parts):
                kernel_slab = metric(AVAILABLE, sum(slab_parts), "derived from SReclaimable + SUnreclaim")
            else:
                kernel_slab = metric(UNAVAILABLE, note="requires Slab or both slab component counters")
        zswap_paths = {
            "enabled": "/sys/kernel/mm/zswap/enabled",
            "compressor": "/sys/kernel/mm/zswap/compressor",
            "max_pool_percent": "/sys/kernel/mm/zswap/max_pool_percent",
            "zpool": "/sys/kernel/mm/zswap/zpool",
        }
        zswap = {key: self.text_metric(path) for key, path in zswap_paths.items()}
        usage = {}
        for name in ("stored_pages", "pool_total_size", "written_back_pages", "pool_limit_hit", "reject_compress_poor", "reject_alloc_fail", "reject_kmemcache_fail"):
            usage[name] = self.text_metric(f"/sys/kernel/debug/zswap/{name}")
        management = {
            key: self.text_metric(path)
            for key, path in (("swappiness", "/proc/sys/vm/swappiness"), ("page_cluster", "/proc/sys/vm/page-cluster"), ("mglru_enabled", "/sys/kernel/mm/lru_gen/enabled"), ("mglru_min_ttl_ms", "/sys/kernel/mm/lru_gen/min_ttl_ms"))
        }
        return {
            **values,
            "used_bytes": used,
            "swap_used_bytes": swap_used,
            "kernel_slab_bytes": kernel_slab,
            "meminfo_semantics": metric(AVAILABLE, {
                "used_bytes": "MemTotal - MemAvailable; estimate of memory unavailable for new allocations, not process PSS",
                "non_additive_fields": ["Cached", "Shmem", "Mapped", "AnonPages", "SReclaimable", "SUnreclaim", "Slab", "Active", "Inactive"],
                "slab": "Slab is the total; SReclaimable and SUnreclaim are its components and must not be added to Slab",
            }),
            "zswap_config": zswap,
            "zswap_usage": usage,
            "swappiness": management["swappiness"],
            "page_cluster": management["page_cluster"],
            "mglru_enabled": management["mglru_enabled"],
            "mglru_min_ttl_ms": management["mglru_min_ttl_ms"],
        }

    def memory_diagnostic(self) -> dict[str, Any]:
        observation = benchmark_metrics.observe(
            root_prefix=self.root_prefix,
            duration=self.observation_window,
            sample_period=self.profile_sample_period,
            profile=None,
        )
        root = self.root_prefix or pathlib.Path("/")
        drm = benchmark_metrics.drm_fdinfo_snapshot(root, observation["processes"])
        return memory_report.build_memory_diagnostic(
            collected_at=dt.datetime.now(dt.timezone.utc).isoformat(),
            system=self.system(),
            observation=observation,
            memory=self.memory(),
            cgroup_v2=self.cgroup(),
            systemd_user_cgroup=observation["systemd_user_cgroup"],
            quickshell_cgroup=observation["quickshell_cgroup"],
            memory_management=self.memory_management(),
            drm=drm,
        )

    def cgroup(self) -> dict[str, Any]:
        cg, error = read_text(self.path("/proc/self/cgroup"))
        rel = None
        if cg:
            for line in cg.splitlines():
                parts = line.split(":", 2)
                if len(parts) == 3 and parts[0] == "0":
                    rel = parts[2].lstrip("/")
                    break
        root = self.path("/sys/fs/cgroup")
        base = root / rel if rel else root
        if not base.exists():
            not_applicable = metric(NOT_APPLICABLE, note="cgroup v2 hierarchy not visible")
            return {
                "unified": not_applicable,
                "path": metric(status_for_error(error), note="/proc/self/cgroup unavailable" if error else "cgroup v2 path unavailable"),
                "memory_current": not_applicable,
                "memory_stat": not_applicable,
                "memory_events": not_applicable,
                "memory_pressure": not_applicable,
                "cpu_stat": not_applicable,
                "io_stat": not_applicable,
            }
        result: dict[str, Any] = {"unified": metric(AVAILABLE, True), "path": metric(AVAILABLE, "/" + rel if rel else "/")}
        for key, filename in (("memory_current", "memory.current"), ("memory_stat", "memory.stat"), ("memory_events", "memory.events"), ("memory_pressure", "memory.pressure"), ("cpu_stat", "cpu.stat"), ("io_stat", "io.stat")):
            value, read_error = read_text(base / filename)
            if read_error:
                result[key] = metric(status_for_error(read_error), note=f"{filename}: {read_error}")
            elif filename in ("memory.stat", "memory.events", "cpu.stat"):
                result[key] = metric(AVAILABLE, parse_key_values(value))
            elif filename == "memory.current":
                try:
                    result[key] = metric(AVAILABLE, int(value.strip()))
                except ValueError:
                    result[key] = metric(UNAVAILABLE, note="malformed memory.current")
            else:
                result[key] = metric(AVAILABLE, value.strip())
        return result

    def pressure(self) -> dict[str, Any]:
        return {key: self.text_metric(f"/proc/pressure/{key}") for key in ("cpu", "memory", "io")}

    def units(self, scope: str, kind: str) -> dict[str, Any]:
        args = ["systemctl"]
        if scope == "user":
            args.append("--user")
        args += ["list-units", f"--type={kind}", "--all", "--no-legend", "--no-pager"]
        result = command(args, timeout=8)
        if result["status"] != AVAILABLE:
            return result
        rows = []
        for line in result.get("value", "").splitlines():
            fields = line.split(None, 4)
            if fields:
                rows.append({"unit": fields[0], "load": fields[1] if len(fields) > 1 else None, "active": fields[2] if len(fields) > 2 else None, "sub": fields[3] if len(fields) > 3 else None, "description": fields[4] if len(fields) > 4 else None})
        return metric(AVAILABLE, rows)

    def session(self, processes: list[dict[str, Any]], counts: dict[str, Any]) -> dict[str, Any]:
        complete = (
            counts.get("enumeration_available", 0) == 1
            and counts.get("identity_changed", 0) == 0
            and counts.get("stat_permission", 0) == 0
            and counts.get("stat_unavailable", 0) == 0
        )
        return {
            "processes": metric(
                AVAILABLE if processes and complete else UNAVAILABLE,
                processes,
                f"process scan outcomes: {counts}",
            ),
            "system_services": self.units("system", "service"),
            "user_services": self.units("user", "service"),
            "system_timers": self.units("system", "timer"),
            "user_timers": self.units("user", "timer"),
            "system_sockets": self.units("system", "socket"),
            "user_sockets": self.units("user", "socket"),
            "xdg_autostarts": self.autostarts(),
            "dbus_activatable_services": self.dbus_services(),
        }

    def autostarts(self) -> dict[str, Any]:
        roots = [self.path("/etc/xdg/autostart"), self.path("/usr/share/xdg/autostart"), pathlib.Path.home() / ".config/autostart"]
        entries = []
        found = False
        for root in roots:
            try:
                for path in sorted(root.glob("*.desktop")):
                    found = True
                    text, error = read_text(path)
                    if text is not None:
                        safe = {}
                        in_desktop_entry = False
                        for line in text.splitlines():
                            if line.strip() == "[Desktop Entry]":
                                in_desktop_entry = True
                            elif line.startswith("["):
                                in_desktop_entry = False
                            elif in_desktop_entry and "=" in line:
                                key, value = line.split("=", 1)
                                if key in ("Name", "Hidden", "NoDisplay", "OnlyShowIn", "NotShowIn", "DBusActivatable"):
                                    safe[key] = value
                        entries.append({"desktop_id": path.name, "metadata": safe})
            except PermissionError:
                continue
        return metric(AVAILABLE, entries) if found or all(root.exists() for root in roots) else metric(UNAVAILABLE, entries, "XDG autostart directories not found or unreadable")

    def dbus_services(self) -> dict[str, Any]:
        roots = [self.path("/usr/share/dbus-1/services"), pathlib.Path.home() / ".local/share/dbus-1/services"]
        files = []
        for root in roots:
            try:
                files.extend(str(p) for p in sorted(root.glob("*.service")))
            except OSError:
                continue
        names = sorted({pathlib.Path(value).name for value in files})
        return metric(AVAILABLE, names) if names or any(p.exists() for p in roots) else metric(UNAVAILABLE, note="D-Bus service directories unavailable")

    def memory_management(self) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, path in (("zswap_enabled", "/sys/kernel/mm/zswap/enabled"), ("zswap_compressor", "/sys/kernel/mm/zswap/compressor"), ("zswap_max_pool_percent", "/sys/kernel/mm/zswap/max_pool_percent"), ("swappiness", "/proc/sys/vm/swappiness"), ("page_cluster", "/proc/sys/vm/page-cluster"), ("mglru_enabled", "/sys/kernel/mm/lru_gen/enabled"), ("mglru_min_ttl_ms", "/sys/kernel/mm/lru_gen/min_ttl_ms")):
            result[key] = self.text_metric(path)
        result["zswap_usage"] = {name: self.text_metric(f"/sys/kernel/debug/zswap/{name}") for name in ("stored_pages", "pool_total_size", "written_back_pages", "pool_limit_hit", "reject_compress_poor", "reject_alloc_fail")}
        result["systemd_oomd_active"] = command(["systemctl", "is-active", "systemd-oomd.service"])
        result["oomctl"] = command(["oomctl", "--no-pager"])
        return result

    def storage(self) -> dict[str, Any]:
        return {"findmnt": command(["findmnt", "--json", "--output", "TARGET,SOURCE,FSTYPE,OPTIONS"], timeout=8), "diskstats": self.text_metric("/proc/diskstats")}

    def network(self, session: dict[str, Any]) -> dict[str, Any]:
        config_paths = [self.path("/etc/NetworkManager/NetworkManager.conf")]
        try:
            config_paths += list(self.path("/etc/NetworkManager/conf.d").glob("*.conf")) if self.path("/etc/NetworkManager/conf.d").exists() else []
        except OSError:
            pass
        configs = []
        for path in config_paths:
            content, error = read_text(path)
            if content is not None:
                section = ""
                relevant = {}
                for line in content.splitlines():
                    stripped = line.strip()
                    if stripped.startswith("[") and stripped.endswith("]"):
                        section = stripped[1:-1].lower()
                    elif "=" in stripped:
                        key, value = (part.strip() for part in stripped.split("=", 1))
                        if (section == "main" and key.lower() in ("plugins", "dns", "rc-manager")) or (section == "device" and key.lower() in ("wifi.backend", "wifi.scan-rand-mac-address")):
                            relevant[f"{section}.{key}"] = value
                if relevant:
                    configs.append({"file": path.name, "backend_settings": relevant})
        modules, mod_error = read_text(self.path("/proc/modules"))
        wifi_modules = [line.split()[0] for line in modules.splitlines() if line.split() and any(token in line.split()[0].lower() for token in ("brcm", "iwl", "ath", "cfg80211", "mac80211"))] if modules else None
        related = {}
        for scope in ("system_services", "user_services"):
            units = session[scope]
            if units["status"] != AVAILABLE:
                related[scope] = units
            else:
                related[scope] = metric(AVAILABLE, [row for row in units.get("value", []) if any(token in row["unit"].lower() for token in ("networkmanager", "wpa_supplicant", "iwd", "avahi", "modemmanager", "bluetooth"))])
        return {
            "networkmanager_backend_config": metric(AVAILABLE, configs) if configs else metric(UNAVAILABLE, note="no readable NetworkManager configuration found"),
            "wifi_kernel_modules": metric(AVAILABLE, wifi_modules) if wifi_modules is not None else metric(status_for_error(mod_error), note=mod_error),
            "networkmanager_state": command(["nmcli", "--terse", "--fields", "RUNNING,VERSION", "general"]),
            "related_services": related,
        }

    def audio(self, session: dict[str, Any]) -> dict[str, Any]:
        system_units = session["system_services"]
        user_units = session["user_services"]
        def matching(units: dict[str, Any], tokens: tuple[str, ...]) -> dict[str, Any]:
            if units["status"] != AVAILABLE:
                return units
            rows = [row for row in units.get("value", []) if any(token in row["unit"].lower() for token in tokens)]
            return metric(AVAILABLE, rows)
        return {
            "pipewire_services": matching(user_units, ("pipewire", "wireplumber")),
            "speakersafetyd_state": matching(system_units, ("speakersafetyd",)),
            "pw_top": command(["pw-top", "-b", "-n", "1"], timeout=4),
        }

    def snapshot(self, profile: str | None = None) -> dict[str, Any]:
        observation = benchmark_metrics.observe(
            root_prefix=self.root_prefix,
            duration=self.observation_window,
            sample_period=self.profile_sample_period,
            profile=profile,
        )
        processes = observation["processes"]
        counts = observation["process_read_outcomes"]["end"]
        session = self.session(processes, counts)
        graphics_memory = benchmark_metrics.drm_fdinfo_snapshot(
            self.root_prefix or pathlib.Path("/"), processes
        )
        cpu = {
            **observation["cpu_delta"],
            "loadavg": self.text_metric("/proc/loadavg"),
        }
        return {
            "collected_at": dt.datetime.now(dt.timezone.utc).isoformat(),
            "schema_version": 2,
            "profile": profile,
            "profile_validation": observation["profile_validation"],
            "collector": {
                "read_only": True,
                "host_modified": False,
                "observation_window_seconds": observation["observation_window_seconds"],
                "process_observation_window_seconds": observation["process_observation_window_seconds"],
                "profile_sample_period_seconds": self.profile_sample_period,
                "process_smaps_rollup_outcomes": counts,
                "process_scans": observation["process_scan_timings"],
            },
            "system": self.system(),
            "memory": self.memory(),
            "memory_scopes": observation["memory_scopes"],
            "components": observation["components"],
            "graphics_memory": {
                "drm_fdinfo": graphics_memory,
                "accounting_note": "DRM counters are optional driver reports and may refer to buffers backed by system DRAM; never add them to PSS or global memory.",
            },
            "cgroup_v2": self.cgroup(),
            "systemd_user_cgroup": observation["systemd_user_cgroup"],
            "quickshell_cgroup": observation["quickshell_cgroup"],
            "psi": {
                "start": observation["psi_start"],
                "end": observation["psi_end"],
                "delta": observation["psi_delta"],
            },
            "cpu": cpu,
            "session": session,
            "memory_management": self.memory_management(),
            "storage": self.storage(),
            "network": self.network(session),
            "audio": self.audio(session),
        }

def _metric_number(snapshot: dict[str, Any], path: tuple[str, ...]) -> float | None:
    value: Any = snapshot
    for part in path:
        if not isinstance(value, dict):
            return None
        value = value.get(part)
    if isinstance(value, dict) and value.get("status") == AVAILABLE and isinstance(value.get("value"), (int, float)):
        return float(value["value"])
    return None


def scalar_samples(snapshot: dict[str, Any]) -> dict[str, float]:
    paths = {
        "memory.mem_total_bytes": ("memory", "mem_total_bytes"),
        "memory.mem_available_bytes": ("memory", "mem_available_bytes"),
        "memory.used_bytes": ("memory", "used_bytes"),
        "memory.mem_free_bytes": ("memory", "mem_free_bytes"),
        "memory.buffers_bytes": ("memory", "buffers_bytes"),
        "memory.cached_bytes": ("memory", "cached_bytes"),
        "memory.shmem_bytes": ("memory", "shmem_bytes"),
        "memory.slab_bytes": ("memory", "slab_bytes"),
        "memory.sreclaimable_bytes": ("memory", "sreclaimable_bytes"),
        "memory.sunreclaim_bytes": ("memory", "sunreclaim_bytes"),
        "memory.anon_pages_bytes": ("memory", "anon_pages_bytes"),
        "memory.mapped_bytes": ("memory", "mapped_bytes"),
        "memory.kernel_stack_bytes": ("memory", "kernel_stack_bytes"),
        "memory.page_tables_bytes": ("memory", "page_tables_bytes"),
        "memory.unevictable_bytes": ("memory", "unevictable_bytes"),
        "memory.active_bytes": ("memory", "active_bytes"),
        "memory.inactive_bytes": ("memory", "inactive_bytes"),
        "memory.swap_total_bytes": ("memory", "swap_total_bytes"),
        "memory.swap_free_bytes": ("memory", "swap_free_bytes"),
        "memory.swap_used_bytes": ("memory", "swap_used_bytes"),
        "memory.kernel_stack_bytes": ("memory", "kernel_stack_bytes"),
        "memory.page_tables_bytes": ("memory", "page_tables_bytes"),
        "memory.session_pss_bytes": ("memory_scopes", "session", "pss_bytes"),
        "memory.session_swap_pss_bytes": ("memory_scopes", "session", "swap_pss_bytes"),
        "cpu.system_busy_percent_delta": ("cpu", "busy_percent_delta"),
        "cpu.system_idle_percent_delta": ("cpu", "idle_percent_delta"),
    }
    for component in ("niri", "quickshell", "pipewire", "wireplumber", "networkmanager", "xwayland_satellite"):
        paths[f"components.{component}.pss_bytes"] = ("components", component, "pss_bytes")
        paths[f"components.{component}.cpu_seconds_delta"] = ("components", component, "cpu_seconds_delta")
    result = {}
    for label, path in paths.items():
        value = _metric_number(snapshot, path)
        if value is not None:
            result[label] = value
    drm = snapshot.get("graphics_memory", {}).get("drm_fdinfo", {})
    drm_value = drm.get("value", {}) if drm.get("status") == AVAILABLE else {}
    for region, value in drm_value.get("resident_bytes_by_region", {}).items():
        if isinstance(value, (int, float)) and not isinstance(value, bool):
            result[f"graphics.drm_resident.{region}_bytes"] = float(value)
    return result


def write_output_atomic(destination: pathlib.Path, rendered: str) -> None:
    """Write a complete private JSON result or leave the previous result intact."""
    destination.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f".{destination.name}.", suffix=".tmp", dir=destination.parent)
    temp_path = pathlib.Path(temp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            output.write(rendered)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temp_path, destination)
        directory_fd = os.open(destination.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except BaseException:
        temp_path.unlink(missing_ok=True)
        raise


def collect_memory_series(
    *,
    window: float,
    sample_period: float,
    include_60_minutes: bool = False,
    output: pathlib.Path | None = None,
    collector_factory=None,
    sleeper=time.sleep,
    monotonic=time.monotonic,
    emit=print,
) -> dict[str, Any]:
    """Take finite snapshots at elapsed 0/5/15/30 minutes (optionally 60)."""
    schedule = [0, 5 * 60, 15 * 60, 30 * 60]
    if include_60_minutes:
        schedule.append(60 * 60)
    factory = collector_factory or (lambda: Collector(observation_window=window, profile_sample_period=sample_period))
    started = monotonic()
    samples: list[dict[str, Any]] = []
    payload: dict[str, Any] = {
        "schema_version": 1,
        "mode": "memory-longitudinal",
        "read_only": True,
        "host_modified": False,
        "schedule_seconds": schedule,
        "complete": False,
        "samples": samples,
    }
    for index, scheduled in enumerate(schedule):
        wait_seconds = scheduled - (monotonic() - started)
        if wait_seconds > 0:
            emit(f"Next memory sample in {wait_seconds:.0f} seconds (scheduled +{scheduled}s).")
            sleeper(wait_seconds)
        diagnostic = factory().memory_diagnostic()
        sample = {
            "index": index,
            "scheduled_offset_seconds": scheduled,
            "elapsed_seconds": max(0.0, monotonic() - started),
            "diagnostic": diagnostic,
        }
        samples.append(sample)
        payload["trend_analysis"] = memory_report.analyze_memory_series(samples)
        if index + 1 == len(schedule):
            payload["complete"] = True
        if output:
            write_output_atomic(output, json.dumps(payload, indent=2, ensure_ascii=False, sort_keys=True) + "\n")
        emit(f"\nSample {index + 1}/{len(schedule)} at +{sample['elapsed_seconds']:.0f}s")
        emit(memory_report.render_memory_report(diagnostic))
    if output:
        emit(f"\nLongitudinal JSON updated: {output}")
    emit("\nTrend assessment")
    emit(json.dumps(payload.get("trend_analysis", {}), indent=2, ensure_ascii=False, sort_keys=True))
    return payload


def collect_memory_diagnostic(*, window: float, sample_period: float, output: pathlib.Path | None = None) -> dict[str, Any]:
    diagnostic = Collector(observation_window=window, profile_sample_period=sample_period).memory_diagnostic()
    print(memory_report.render_memory_report(diagnostic))
    if output:
        write_output_atomic(output, json.dumps(diagnostic, indent=2, ensure_ascii=False, sort_keys=True) + "\n")
        print(f"\nJSON snapshot written: {output}")
    return diagnostic


def _self_proc_metrics() -> dict[str, Any]:
    smaps, smaps_error = read_text(pathlib.Path("/proc/self/smaps_rollup"))
    io, io_error = read_text(pathlib.Path("/proc/self/io"))
    values = parse_key_values(smaps or "")
    io_values = benchmark_metrics.parse_proc_io(io)
    return {
        "pss_bytes": metric(AVAILABLE, values["Pss"] * 1024) if "Pss" in values else metric(status_for_error(smaps_error), note=smaps_error or "Pss unavailable"),
        "io_read_bytes": metric(AVAILABLE, io_values["read_bytes"]) if "read_bytes" in io_values else metric(status_for_error(io_error), note=io_error or "read_bytes unavailable"),
        "io_write_bytes": metric(AVAILABLE, io_values["write_bytes"]) if "write_bytes" in io_values else metric(status_for_error(io_error), note=io_error or "write_bytes unavailable"),
    }


def diagnose_collector_overhead(runs: int) -> dict[str, Any]:
    """Measure the collector itself separately; never subtract these estimates."""
    collector = Collector(observation_window=0, profile_sample_period=0.2)
    samples: list[dict[str, Any]] = []
    original_run = subprocess.run
    for index in range(runs):
        commands: dict[str, dict[str, Any]] = {}

        def measured_run(args, *positional, **kwargs):
            started = time.perf_counter()
            try:
                return original_run(args, *positional, **kwargs)
            finally:
                elapsed = time.perf_counter() - started
                argv = args if isinstance(args, (list, tuple)) else [str(args)]
                executable = pathlib.Path(str(argv[0])).name if argv else "unknown"
                entry = commands.setdefault(executable, {"count": 0, "wall_seconds": 0.0})
                entry["count"] += 1
                entry["wall_seconds"] += elapsed

        subprocess.run = measured_run
        try:
            before_usage = resource.getrusage(resource.RUSAGE_SELF)
            before_self = _self_proc_metrics()
            started = time.perf_counter()
            try:
                snapshot = collector.snapshot(profile=None)
            finally:
                elapsed = time.perf_counter() - started
                after_usage = resource.getrusage(resource.RUSAGE_SELF)
                after_self = _self_proc_metrics()
        finally:
            subprocess.run = original_run
        process_cpu = (after_usage.ru_utime - before_usage.ru_utime) + (after_usage.ru_stime - before_usage.ru_stime)
        scans = snapshot["collector"]["process_scans"]
        samples.append({
            "run": index + 1,
            "wall_seconds": elapsed,
            "process_cpu_seconds": process_cpu,
            "process_cpu_percent_of_one_core": 100.0 * process_cpu / max(elapsed, 1e-9),
            "self_memory": {"before": before_self, "after": after_self},
            "self_io_delta_bytes": {
                key: metric(AVAILABLE, after_self[key]["value"] - before_self[key]["value"])
                if before_self[key]["status"] == after_self[key]["status"] == AVAILABLE
                else metric(UNAVAILABLE)
                for key in ("io_read_bytes", "io_write_bytes")
            },
            "resource_usage_delta": {
                "minor_page_faults": after_usage.ru_minflt - before_usage.ru_minflt,
                "major_page_faults": after_usage.ru_majflt - before_usage.ru_majflt,
                "voluntary_context_switches": after_usage.ru_nvcsw - before_usage.ru_nvcsw,
                "nonvoluntary_context_switches": after_usage.ru_nivcsw - before_usage.ru_nivcsw,
                "maxrss_kib_high_water_before": before_usage.ru_maxrss,
                "maxrss_kib_high_water_after": after_usage.ru_maxrss,
            },
            "process_scans": scans,
            "subprocesses": commands,
            "read_only": snapshot["collector"]["read_only"] and not snapshot["collector"]["host_modified"],
        })
    numeric = ("wall_seconds", "process_cpu_seconds", "process_cpu_percent_of_one_core")
    summary = {}
    for key in numeric:
        values = [float(sample[key]) for sample in samples]
        median = statistics.median(values)
        summary[key] = {
            "n": len(values),
            "median": median,
            "mad": statistics.median(abs(value - median) for value in values),
            "min": min(values),
            "max": max(values),
        }
    return {
        "schema_version": 1,
        "mode": "collector-overhead-diagnostic",
        "read_only": True,
        "subtracted_from_benchmark": False,
        "note": (
            "Diagnostic runs use zero idle observation time and measure collector CPU/wall time, "
            "process scan reads, subprocess costs, self PSS, I/O and resource counters. This is an "
            "instrumentation diagnostic, not an estimate to subtract from desktop measurements."
        ),
        "runs": samples,
        "summary": summary,
    }

def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--profile", choices=("plasma", "niri-core", "niri-quickshell"),
                        help="requested session profile; the collector validates it against the live host")
    mode.add_argument("--diagnose-overhead", action="store_true",
                      help="run a separate, read-only diagnostic of this collector's observer overhead")
    mode.add_argument("--memory-diagnostic", action="store_true",
                      help="print a read-only global/process/cgroup memory accounting report")
    mode.add_argument("--memory-series", action="store_true",
                      help="take finite memory snapshots at 0, 5, 15, and 30 minutes")
    parser.add_argument("--runs", type=int, default=1,
                        help="collect repeated snapshots; use 5 for the documented idle protocol")
    parser.add_argument("--window", type=float, default=10.0,
                        help="seconds in each CPU/fault/I/O delta observation window")
    parser.add_argument("--profile-sample-period", type=float, default=0.5,
                        help="seconds between lightweight profile-presence checks during the window")
    parser.add_argument("--memory-window", type=float, default=2.0,
                        help="seconds used to measure process CPU during a memory diagnostic")
    parser.add_argument("--memory-sample-period", type=float, default=0.5,
                        help="seconds between lightweight samples during a memory diagnostic window")
    parser.add_argument("--include-60-minutes", action="store_true",
                        help="add a final +60 minute snapshot to --memory-series")
    parser.add_argument("--output", type=pathlib.Path,
                        help="optional JSON destination; memory modes still print human-readable reports")
    args = parser.parse_args()
    if args.include_60_minutes and not args.memory_series:
        parser.error("--include-60-minutes requires --memory-series")
    if args.memory_diagnostic or args.memory_series:
        window = args.memory_window
        sample_period = args.memory_sample_period
        if window < 0.5 or window > 15:
            parser.error("memory observation window must be between 0.5 and 15 seconds")
        if sample_period < 0.2 or sample_period > window:
            parser.error("memory sample period must be between 0.2 seconds and the memory observation window")
        if args.memory_series:
            try:
                collect_memory_series(
                    window=window,
                    sample_period=sample_period,
                    include_60_minutes=args.include_60_minutes,
                    output=args.output,
                )
            except KeyboardInterrupt:
                print("Interrupted; the JSON destination contains all completed samples.", file=sys.stderr)
                return 130
            except OSError as exc:
                print(f"cannot finish memory series/output: {exc}", file=sys.stderr)
                return 2
        else:
            try:
                collect_memory_diagnostic(window=window, sample_period=sample_period, output=args.output)
            except OSError as exc:
                print(f"cannot write memory diagnostic output: {exc}", file=sys.stderr)
                return 2
        return 0
    if args.runs < 1 or args.runs > 20:
        parser.error("--runs must be between 1 and 20")
    if args.window < 1 or args.window > 300:
        parser.error("--window must be between 1 and 300 seconds")
    if args.profile_sample_period < 0.2 or args.profile_sample_period > args.window:
        parser.error("--profile-sample-period must be between 0.2 seconds and --window")

    if args.diagnose_overhead:
        diagnostic = diagnose_collector_overhead(args.runs)
        rendered = json.dumps(diagnostic, indent=2, ensure_ascii=False, sort_keys=True) + "\n"
        if args.output:
            try:
                write_output_atomic(args.output, rendered)
            except OSError as exc:
                print(f"cannot write output: {exc}", file=sys.stderr)
                return 2
        else:
            sys.stdout.write(rendered)
        return 0

    collector = Collector(observation_window=args.window, profile_sample_period=args.profile_sample_period)
    snapshots = []
    for run_index in range(args.runs):
        snapshot = collector.snapshot(args.profile)
        snapshots.append(snapshot)
        if snapshot["profile_validation"]["status"] != benchmark_metrics.PROFILE_OK:
            diagnostic = {
                "schema_version": 2,
                "profile": args.profile,
                "failed_run": run_index + 1,
                "profile_validation": snapshot["profile_validation"],
            }
            print(json.dumps(diagnostic, indent=2, ensure_ascii=False, sort_keys=True), file=sys.stderr)
            print("profile validation failed; no benchmark result was written", file=sys.stderr)
            return 3

    payload: dict[str, Any] = {
        "schema_version": 2,
        "read_only": True,
        "profile": args.profile,
        "profile_validation": {
            "status": benchmark_metrics.PROFILE_OK,
            "runs": [snapshot["profile_validation"]["evidence"] for snapshot in snapshots],
        },
        "aggregation": {
            "system_wide": "MemAvailable/swap and PSI come from kernel system-wide interfaces.",
            "session": snapshots[0]["memory_scopes"]["session"]["definition"] if snapshots else "",
            "per_process": "Memory comes from one smaps_rollup per PID; CPU/fault/I/O values are counter deltas across the same observation window.",
            "components": "Component aggregates are views over unique process PIDs and are not added to session PSS.",
            "cgroups": "cgroup memory.current is reported separately and is never added to PSS; cgroup deltas capture short-lived children.",
        },
        "runs": snapshots,
    }
    if args.runs > 1:
        columns: dict[str, list[float]] = {}
        for snapshot in snapshots:
            for name, value in scalar_samples(snapshot).items():
                columns.setdefault(name, []).append(value)
        summary = {}
        for name, values in columns.items():
            med = statistics.median(values)
            summary[name] = {
                "n": len(values),
                "median": med,
                "mad": statistics.median(abs(value - med) for value in values),
                "min": min(values),
                "max": max(values),
            }
        payload["summary"] = summary

    rendered = json.dumps(payload, indent=2, ensure_ascii=False, sort_keys=True) + "\n"
    if args.output:
        try:
            write_output_atomic(args.output, rendered)
        except OSError as exc:
            print(f"cannot write output: {exc}", file=sys.stderr)
            return 2
    else:
        sys.stdout.write(rendered)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
